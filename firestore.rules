rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra para a coleção de tarefas pareando pelo UserID (uid)
    match /tasks/{taskId} {
      // Leitura, criação, atualização e exclusão permitidas apenas se:
      // 1. O usuário estiver autenticado (request.auth != null)
      // 2. O e-mail estiver verificado (request.auth.token.email_verified == true)
      // 3. Os dados pertencerem estritamente ao usuário logado (userId == request.auth.uid)
      
      allow read: if request.auth != null 
                  && request.auth.token.email_verified == true 
                  && resource.data.userId == request.auth.uid;
                  
      allow create: if request.auth != null 
                    && request.auth.token.email_verified == true 
                    && request.resource.data.userId == request.auth.uid;
                    
      allow update, delete: if request.auth != null 
                            && request.auth.token.email_verified == true 
                            && resource.data.userId == request.auth.uid;
    }

    // Regra adicional para dados de perfil/usuário caso utilize a coleção users
    match /users/{userId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email_verified == true 
                         && request.auth.uid == userId;
    }
  }
}
